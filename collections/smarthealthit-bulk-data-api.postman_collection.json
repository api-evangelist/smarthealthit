          "id": "3c4ab76d-367c-4b15-bf65-32e77f73ee11",
          "name": "Start a system-level bulk export (Bulk Data server only)",
          "request": {
            "name": "Start a system-level bulk export (Bulk Data server only)",
            "description": {
              "content": "Kicks off an asynchronous export of all resources on the reference Bulk Data server (https://bulk-data.smarthealthit.org/fhir). Requires the Prefer respond-async header and a SMART Backend Services access token. Responds 202 with a Content-Location status URL to poll (honor Retry-After); when complete, the status endpoint returns a manifest of NDJSON file URLs to download.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "$export"
              ],
              "host": [
                "{{$export-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "_outputFormat",
                  "value": "<string>",
                  "description": "Requested bulk output format; defaults to application/fhir+ndjson."
                },
                {
                  "disabled": false,
                  "key": "_type",
                  "value": "<string>",
                  "description": "Comma-separated FHIR resource types to include in the export."
                },
                {
                  "disabled": false,
                  "key": "_since",
                  "value": "<dateTime>",
                  "description": "Only include resources modified after this instant."
                }
              ],
              "variable": []
            },
